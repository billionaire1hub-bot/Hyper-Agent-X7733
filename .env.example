# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Vercel sets NODE_ENV and VERCEL automatically. PORT is only used by
# long-running hosts (npm start); Vercel ignores it.
NODE_ENV="production"
PORT="3000"

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
AGENT_NAME="Hyper Agent X7733"
AGENT_SLUG="hyper-agent-x7733"
AGENT_DESCRIPTION="Hyper Agent X7733: ACP-compliant Base utility agent for on-chain swaps, transfers and startup funding plus live AI market intelligence and autonomous X publishing."
# Recommended for absolute A2A URLs and custom domains. On Vercel the agent
# also observes its deployment host from the first inbound request, saves it,
# and immediately wakes outreach when the Virtuals chat URL starts calling it.
PUBLIC_BASE_URL=""

# Optional shared secret. When set, every state-changing POST must send
# `x-api-key: <API_KEY>`; POST /api/chat also accepts a rotated BOSS_PASSCODE.
API_KEY=""

# Secret that authenticates every /api/cron/* endpoint (intake, sweep,
# outreach, revenue, social) and the agent's own outreach wake-up call.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`; the self-wake
# and other schedulers send `x-cron-secret`; a browser may use ?secret=. Only
# /api/cron/* and GET /api/outreach read a query secret; API-key routes never
# do. With this empty the cron endpoints answer 503 and outreach stays dark.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Boss (admin) passcode for the chat surface
# ---------------------------------------------------------------------------
# A chat message containing this passcode is answered with the boss
# acknowledgement and authenticates POST /api/chat instead of x-api-key; a
# bare passcode message additionally fires outbound agent discovery right
# away. It also unlocks GET /api/outreach?passcode=<value> (add &run=1 to
# trigger a sweep). Must be 8+ characters to authorise a request.
BOSS_PASSCODE="03210388"
# How long a verified passcode keeps the admin commands unlocked for the same
# operator (client id / api key / ip fingerprint).
BOSS_SESSION_TTL_SECONDS="1800"

# ---------------------------------------------------------------------------
# Base mainnet
# ---------------------------------------------------------------------------
# Public endpoint works for smoke tests but is rate limited. Use Alchemy /
# QuickNode / Coinbase CDP for production traffic.
BASE_RPC_URL="https://mainnet.base.org"

# Server execution wallet. Fund with ETH to unlock the six on-chain offerings
# once ONCHAIN_UNLOCK_MIN_USD worth of gas is reached; the 44 zero-gas
# offerings earn without any balance. USDC is only needed to front the
# forwarded share of donation jobs (the ≥20% margin covers the agent's fee).
# 0x-prefixed 32-byte hex private key. NEVER commit this.
AGENT_PRIVATE_KEY=""

# ACP agent id (from app.virtuals.io). Used in metadata and logs only.
ACP_AGENT_ID=""

# ---------------------------------------------------------------------------
# Virtuals ACP escrow
# ---------------------------------------------------------------------------
# Official ACP contract on Base mainnet (from @virtuals-protocol/acp-node-v2).
ACP_CONTRACT_ADDRESS="0x238E541BfefD82238730D00a2208E5497F1832E0"
ACP_API_URL="https://api.acp.virtuals.io"
# Optional bearer token for the ACP API. The /agents endpoint requires auth;
# without a token the outreach engine falls back to on-chain discovery and
# OUTREACH_TARGETS only.
ACP_API_KEY=""

# Automatically submit the deliverable hash on-chain after a successful job.
AUTO_SUBMIT_DELIVERABLE="true"

# Refuse jobs whose escrow expiry is closer than this (seconds).
MIN_ESCROW_WINDOW_SECONDS="90"

# ---------------------------------------------------------------------------
# Autonomous ACP job intake (on-chain discovery)
# ---------------------------------------------------------------------------
# Scans new ids from jobCounter(), keeps FUNDED jobs whose provider is the
# agent wallet, and executes the order carried in the job description:
#   {"offeringId":"token_swap","params":{"sellToken":"USDC","buyToken":"WETH","amount":"1"}}
# Also accepted: token_swap {json}  |  offering:trending_tokens
# Free-form prose is not executed.
ACP_INTAKE_ENABLED="true"
# Local loop cadence for long-running hosts. Vercel uses the cron in vercel.json.
ACP_INTAKE_INTERVAL_SECONDS="60"
ACP_INTAKE_BATCH="3"
ACP_INTAKE_SCAN_LIMIT="40"
ACP_INTAKE_BUDGET_MS="45000"
# First run starts at the current jobCounter unless set. Use this to backfill.
ACP_INTAKE_START_ID="0"

# ---------------------------------------------------------------------------
# A2A surface
# ---------------------------------------------------------------------------
# Agent cards at /.well-known/agent.json and /.well-known/agent-card.json,
# JSON-RPC messages at POST /a2a.
A2A_ENABLED="true"

# ---------------------------------------------------------------------------
# Proactive discovery and outreach
# ---------------------------------------------------------------------------
# ON by default. The loop starts when PUBLIC_BASE_URL is configured or the
# deployed URL is observed on an inbound request. Saving the chat URL on
# Virtuals therefore wakes discovery on the platform's first request.
OUTREACH_ENABLED="true"
OUTREACH_INTERVAL_SECONDS="600"
OUTREACH_BUDGET_MS="40000"
OUTREACH_DAILY_CAP="5"
OUTREACH_MAX_TARGETS="2"
OUTREACH_MIN_SCORE="55"
OUTREACH_COOLDOWN_HOURS="72"
OUTREACH_SCAN_JOBS="60"

# Public, keyless Virtuals sources. The directory includes each agent's tasks
# and social handle; the registry enriches on-chain prospects by wallet.
# The live directory reports ~44k agents over 442 pages of 100. One cycle reads
# OUTREACH_DIRECTORY_PAGES consecutive pages of OUTREACH_DIRECTORY_LIMIT agents
# (400 agents) and stores where the next cycle continues. The cursor wraps at
# the page count the directory itself reported, so the sweep walks the whole
# network and starts again instead of re-reading a fixed subset;
# OUTREACH_DIRECTORY_MAX_PAGES is only the fallback until a cycle has seen one.
OUTREACH_DIRECTORY_URL="https://acpx.virtuals.io/api/agents"
OUTREACH_REGISTRY_URL="https://api.acp.virtuals.io/agents"
OUTREACH_DIRECTORY_LIMIT="100"
OUTREACH_DIRECTORY_PAGES="4"
OUTREACH_DIRECTORY_MAX_PAGES="900"
# Scored candidates examined per cycle (each needs a store read for the
# cooldown/opt-out check) and agent cards probed in parallel for a live A2A
# endpoint. Raise both to widen coverage; the cycle still stops at
# OUTREACH_MAX_TARGETS actual pitches and OUTREACH_BUDGET_MS of work.
OUTREACH_MAX_CANDIDATES="40"
OUTREACH_CARD_PROBES="12"
# Contact directory agents by X mention when they have no public A2A endpoint.
# Set false to restrict outreach to A2A JSON-RPC only.
OUTREACH_X_PITCH="true"

# Authenticated agent directory (JSON array, {data:[]}, {agents:[]}, ...).
# Defaults to the ACP API /agents endpoint, which needs ACP_API_KEY or
# OUTREACH_INDEX_TOKEN. Failures are reported and the cycle continues with the
# allowlist and on-chain discovery.
OUTREACH_INDEX_URL="https://api.acp.virtuals.io/agents"
OUTREACH_INDEX_TOKEN=""
# Comma-separated public HTTPS A2A base URLs or agent-card URLs to contact
# even without a directory. Everything sent here is visible to that agent.
OUTREACH_TARGETS=""
# Extra targeting keywords (e.g. "perps,restaking") matched against a target's
# card text, name and offerings. Domain keywords for DeFi, trading, yield,
# portfolio and market analysis are built in.
OUTREACH_KEYWORDS=""

# Five-minute session cap. An extension is granted once only when the target
# names an explicit budget of at least twice the quote and turns remain.
OUTREACH_SESSION_TTL_SECONDS="300"
OUTREACH_EXTENSION_SECONDS="120"
OUTREACH_MAX_TURNS="6"
OUTREACH_PRICE_MULTIPLIER="1"
OUTREACH_MAX_PRICE_USDC="0.075"
OUTREACH_CARD_TIMEOUT_MS="6000"
OUTREACH_SEND_TIMEOUT_MS="9000"

# ---------------------------------------------------------------------------
# Custom work beyond the 50 registered offerings (custom_task)
# ---------------------------------------------------------------------------
# When none of the registered offerings fits a peer, the outreach cycle asks
# that peer for its exact brief instead of skipping it, and inbound A2A/chat
# requests for uncovered work are quoted from the brief itself. Complexity sets
# the tier price; signals pick the engine: Groq answers fast generation, Gemini
# answers briefs that need deep reasoning or live grounding, and both engines
# fail over to each other. If neither answers, the job fails and the escrow is
# refunded instead of delivered as invented work. Price and routing are derived
# from the requirement text only, so the escrow check recomputes the same amount.
CUSTOM_TASK_ENABLED="true"
CUSTOM_TASK_BASE_PRICE_USDC="0.05"
CUSTOM_TASK_MAX_PRICE_USDC="0.5"
CUSTOM_TASK_MIN_CHARS="24"
CUSTOM_TASK_MAX_CHARS="600"
CUSTOM_TASK_DEEP_THRESHOLD="4"
CUSTOM_TASK_BUDGET_MS="40000"

# ---------------------------------------------------------------------------
# Revenue suite: tiered pricing, quotes, retainers, referrals, happy hour,
# arbitrage/whale alerts, gas advisor, yield radar, credit scoring, bounties
# ---------------------------------------------------------------------------
# The local loop scans live Base pools, ERC20 transfer logs and DefiLlama, then
# delivers retainer feeds, pays referral commissions and pitches anomaly
# bounties. On Vercel it runs through /api/cron/revenue.
REVENUE_ENABLED="true"
REVENUE_INTERVAL_SECONDS="300"
REVENUE_BUDGET_MS="45000"
DONATION_SERVICE_MARGIN_BPS="2000"
# Server-side quote records. Quotes let a client fund below list during happy
# hour or on a performance model; escrow still enforces the quoted minimum.
QUOTE_TTL_SECONDS="900"

# Referral commission only pays after the ACP job reaches COMPLETED on-chain and
# the agent wallet holds the commission plus reserve.
REFERRAL_BPS="700"
REFERRAL_MAX_USDC="10"
REFERRAL_MIN_JOB_AGE_SECONDS="120"
REFERRAL_RESERVE_USDC="1"

# Happy hour: UTC window plus a low-gas bonus. Discount applies to issued quotes
# only; list prices and the escrow minimum do not move.
HAPPY_HOUR_START_UTC="0"
HAPPY_HOUR_END_UTC="6"
HAPPY_HOUR_DISCOUNT_BPS="1500"
HAPPY_HOUR_GAS_DISCOUNT_BPS="500"
HAPPY_HOUR_MAX_GWEI="0.02"

# Live alert thresholds. Nothing is reported unless it crosses these values.
WHALE_LOOKBACK_BLOCKS="40"
WHALE_MIN_USDC="250000"
WHALE_MIN_WETH="100"
ARBITRAGE_MIN_SPREAD_BPS="40"
ARBITRAGE_MIN_LIQUIDITY_USD="50000"

# Anomaly detection compares successive pool snapshots (stored in Upstash).
ANOMALY_LIQUIDITY_DROP_PCT="25"
ANOMALY_PRICE_DROP_PCT="15"
REVENUE_SCAN_POOLS="12"

# Security, new-pool, smart-money and job-radar scanners (read-only live reads).
SECURITY_MIN_LIQUIDITY_USD="25000"
NEW_POOL_LOOKBACK_HOURS="48"
NEW_POOL_MIN_LIQUIDITY_USD="25000"
SMART_MONEY_MIN_USD="50000"
SMART_MONEY_LOOKBACK_BLOCKS="40"
BENCHMARK_SCAN_JOBS="150"
JOB_RADAR_SCAN_JOBS="100"

# Retainer delivery cap per day and the per-push timeout.
RETAINER_MAX_DELIVERIES_PER_DAY="2"
RETAINER_SEND_TIMEOUT_MS="9000"

# ---------------------------------------------------------------------------
# AI engines
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
# Per-request output cap for Groq. The free service tier rejects requests above
# 1000 output tokens, so every Groq call is clamped to this value and Gemini
# takes over for the longer JSON briefs.
GROQ_MAX_OUTPUT_TOKENS="1000"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

AI_TIMEOUT_MS="12000"
# Per-request token budget and retry count for synthesis calls.
AI_MAX_OUTPUT_TOKENS="1800"
AI_MAX_RETRIES="1"

# ---------------------------------------------------------------------------
# Live market intelligence data providers
# ---------------------------------------------------------------------------
# All defaults are public and keyless; the providers are queried live for every
# intelligence job. Optional keys only raise rate limits.
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
COINGECKO_API_KEY=""
GECKOTERMINAL_API_URL="https://api.geckoterminal.com/api/v2"
DEFILLAMA_API_URL="https://api.llama.fi"
YIELDS_API_URL="https://yields.llama.fi"
DEXSCREENER_API_URL="https://api.dexscreener.com"
HONEYPOT_API_URL="https://api.honeypot.is/v2"

# Comma-separated live RSS feeds used by crypto_news / mega_report.
# Cointelegraph and Reddit are intentionally not defaults (they block cloud IPs).
NEWS_FEEDS="https://www.coindesk.com/arc/outboundfeeds/rss,https://www.theblock.co/rss.xml,https://decrypt.co/feed,https://cryptoslate.com/feed/"

# Optional X/Twitter API v2 bearer token and the KOL handles to monitor.
# Without them, twitter_alpha / kol_alpha use Gemini Google Search grounding
# citations instead of Twitter posts.
TWITTER_BEARER_TOKEN=""
KOL_HANDLES=""

DATA_TIMEOUT_MS="9000"
GROUNDING_TIMEOUT_MS="20000"
NEWS_TIMEOUT_MS="7000"
INTEL_CACHE_TTL_MS="45000"
INTEL_MAX_NEWS="12"
INTEL_MAX_YIELDS="8"
MIN_YIELD_TVL_USD="5000000"
MIN_TOKEN_LIQUIDITY_USD="25000"

# ---------------------------------------------------------------------------
# Autonomous X (Twitter) article publishing
# ---------------------------------------------------------------------------
# On by default. Set false to pause publishing. Every run still requires live
# AI credentials, user-context X credentials, an idle agent, and a due slot.
SOCIAL_AUTOPOST="true"
SOCIAL_INTERVAL_MINUTES="300"      # 4-6 hour cadence (240-1440)
SOCIAL_TICK_MINUTES="15"           # how often the local loop checks whether it is due
SOCIAL_MAX_POSTS_PER_DAY="4"
SOCIAL_MAX_THREAD_LENGTH="6"
SOCIAL_ARTICLE_MAX_TOKENS="1600"

# User-context posting credentials (OAuth 1.0a): the consumer key and secret
# of the X app, plus the access token pair of the posting account.
X_CONSUMER_KEY=""
X_CONSUMER_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
# Fallback names are accepted too: X_API_KEY / X_API_SECRET,
# TWITTER_API_KEY / TWITTER_API_SECRET, TWITTER_ACCESS_TOKEN /
# TWITTER_ACCESS_TOKEN_SECRET (or TWITTER_ACCESS_SECRET).

# Alternative: an OAuth 2.0 token with tweet.write scope, e.g. one issued
# through a Virtuals Protocol X OAuth connection. The app-only bearer token
# (TWITTER_BEARER_TOKEN above) is read-only and cannot publish, but when
# X_BEARER_TOKEN is set it is tried as a posting token after OAuth 1.0a
# answers 401/403. X_USER_ACCESS_TOKEN / TWITTER_USER_ACCESS_TOKEN are also
# accepted.
X_BEARER_TOKEN=""
X_API_BASE="https://api.x.com/2"

# ---------------------------------------------------------------------------
# Market execution
# ---------------------------------------------------------------------------
KYBERSWAP_API_URL="https://aggregator-api.kyberswap.com/base/api/v1"
KYBERSWAP_CLIENT_ID="virtuals-hyper-agent-x7733"
# Optional gateway key (https://api.kyberswap.com/swap/base/api/v1).
KYBERSWAP_API_KEY=""

DEFAULT_SLIPPAGE_BPS="300"
MIN_SLIPPAGE_BPS="10"
MAX_SLIPPAGE_BPS="2000"

TX_MAX_ATTEMPTS="3"
TX_CONFIRMATIONS="1"
TX_TIMEOUT_MS="45000"
SLA_SECONDS="120"

# Swap principal model. By default the client must approve the agent wallet so
# the sell amount can be pulled with transferFrom; native ETH sells are rejected.
# Only enable this for trusted, pre-funded clients: the agent would otherwise
# risk its own balance for a fee-sized escrow.
ALLOW_AGENT_FUNDED_SWAPS="false"

# ---------------------------------------------------------------------------
# Durable job store (required on Vercel: serverless memory is ephemeral)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Development-only escape hatch: allows /api/chat to execute without an ACP
# escrow job. The config ignores it when VERCEL is set or NODE_ENV=production,
# so a deployed agent can never execute an unfunded job. Never enable on a
# funded production wallet.
# ---------------------------------------------------------------------------
ALLOW_UNPAID_EXECUTION="false"

RATE_LIMIT_PER_MINUTE="30"
LOG_LEVEL="info"
ONCHAIN_UNLOCK_MIN_USD="0.75"
ETH_USD_FALLBACK="3000"
